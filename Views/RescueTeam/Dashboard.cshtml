@model RescueTeamDashboardViewModel
@{
    ViewData["Title"] = $"Rescue Ops: {Model.Team.TeamName}";
}

<div class="row fade-in">
    <!-- Left Column: Command & Operations -->
    <div class="col-lg-6 mb-4">
        <!-- Team Status Card -->
        <div class="glass-card mb-4">
            <div class="card-header-clean bg-light border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="h4 text-dark font-weight-bold mb-1"><i class="fa-solid fa-people-group text-primary me-2"></i> @Model.Team.TeamName</h2>
                    <p class="text-secondary fs-9 mb-0 fw-semibold">Hotline: <strong class="text-dark">@Model.Team.ContactNumber</strong></p>
                </div>
                <div>
                    @if (Model.Team.Status == "Busy" || Model.ActiveAssignment != null)
                    {
                        <span class="badge bg-danger text-uppercase py-2 px-3 fs-9"><i class="fa-solid fa-person-running me-1"></i> Busy on Operation</span>
                    }
                    else if (Model.Team.Status == "Available")
                    {
                        <span class="badge bg-success text-uppercase py-2 px-3 fs-9"><i class="fa-solid fa-circle-check me-1"></i> Available for Dispatch</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary text-uppercase py-2 px-3 fs-9"><i class="fa-solid fa-moon me-1"></i> Offline</span>
                    }
                </div>
            </div>
            
            <div class="card-body-clean">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-secondary fw-semibold">Duty Status Control:</span>
                    @if (Model.Team.Status == "Busy" || Model.ActiveAssignment != null)
                    {
                        <div>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3 fs-9 fw-semibold">
                                <i class="fa-solid fa-lock me-1"></i> Duty Locked: Busy on Operation
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <form asp-controller="RescueTeam" asp-action="ToggleTeamStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="Available" />
                                <button type="submit" class="btn btn-sm btn-outline-success @(Model.Team.Status == "Available" ? "active" : "")">Available</button>
                            </form>
                            <form asp-controller="RescueTeam" asp-action="ToggleTeamStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="status" value="Offline" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary @(Model.Team.Status == "Offline" ? "active" : "")">Offline</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Active Operations Card -->
        <div class="glass-card mb-4">
            <div class="card-header-clean bg-light border-bottom d-flex justify-content-between align-items-center">
                <h3 class="h5 mb-0 text-dark fw-bold"><i class="fa-solid fa-truck-fire text-primary me-2"></i> Current Emergency Task</h3>
                <span class="badge bg-danger text-uppercase px-2.5 py-1 fs-9 fw-semibold"><i class="fa-solid fa-bolt me-1"></i> Active Incident</span>
            </div>
            <div class="card-body-clean">
                @if (Model.ActiveAssignment != null && Model.ActiveAssignment.EmergencyRequest != null)
                {
                    var req = Model.ActiveAssignment.EmergencyRequest;
                    
                    <div class="p-3 mb-3 rounded-3 border" style="background: #f8fafc; border-color: #cbd5e1 !important; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
                        <div class="d-flex justify-content-between align-items-center mb-2.5 pb-2 border-bottom" style="border-color: #e2e8f0 !important;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary text-white p-2 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-triangle-exclamation fs-7"></i>
                                </span>
                                <h4 class="h5 text-dark fw-bold mb-0">@req.EmergencyType Incident</h4>
                            </div>
                            <span class="badge-priority badge-@req.PriorityLevel.ToLowerInvariant() px-3 py-1.5 shadow-xs">@req.PriorityLevel Priority</span>
                        </div>

                        <!-- Incident Description in High-Contrast White Card -->
                        <div class="p-3 mb-3 rounded-2 bg-white border" style="border-color: #e2e8f0 !important;">
                            <span class="text-secondary fs-9 text-uppercase fw-bold d-block mb-1"><i class="fa-solid fa-circle-info text-primary me-1"></i> Incident Report Description:</span>
                            <p class="text-dark fs-8 mb-0 fw-medium" style="line-height: 1.55; color: #0f172a !important;">"@req.Description"</p>
                        </div>
                        
                        <!-- Contact & Location Metadata -->
                        <div class="row g-2 mb-3">
                            <div class="col-sm-6">
                                <div class="p-2.5 rounded-2 bg-white border h-100" style="border-color: #e2e8f0 !important;">
                                    <span class="d-block text-secondary fs-9 text-uppercase fw-bold mb-1"><i class="fa-solid fa-user text-primary me-1"></i> Citizen Contact:</span>
                                    <span class="text-dark fw-bold fs-8 d-block" style="color: #0f172a !important;">@(req.Citizen?.FullName ?? "N/A")</span>
                                    @if (!string.IsNullOrEmpty(req.Citizen?.PhoneNumber))
                                    {
                                        <span class="text-muted fs-9 font-monospace"><i class="fa-solid fa-phone me-1 text-success"></i> @req.Citizen.PhoneNumber</span>
                                    }
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-2.5 rounded-2 bg-white border h-100" style="border-color: #e2e8f0 !important;">
                                    <span class="d-block text-secondary fs-9 text-uppercase fw-bold mb-1"><i class="fa-solid fa-location-dot text-danger me-1"></i> Report Location:</span>
                                    <span class="text-dark fw-bold fs-8 font-monospace d-block" style="color: #0f172a !important;">@req.Latitude.ToString("F4"), @req.Longitude.ToString("F4")</span>
                                    <span class="text-muted fs-9"><i class="fa-solid fa-satellite me-1 text-primary"></i> GPS Coordinates</span>
                                </div>
                            </div>
                        </div>

                        <!-- Current Assignment State Actions -->
                        <div class="p-3 rounded-2 bg-white border" style="border-color: #e2e8f0 !important;">
                            <div class="d-flex justify-content-between align-items-center mb-2.5">
                                <span class="text-secondary fs-9 fw-bold text-uppercase">Operational Dispatch Stage:</span>
                                <span>
                                    <span class="badge bg-warning bg-opacity-20 text-dark border border-warning px-3 py-1 fs-8 fw-bold" id="operationStatus">
                                        <i class="fa-solid fa-circle-dot text-warning me-1"></i> @req.Status
                                    </span>
                                </span>
                            </div>

                            <div class="action-buttons-group">
                                @if (Model.ActiveAssignment.Status == "Assigned")
                                {
                                    <form asp-controller="RescueTeam" asp-action="Accept" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <button type="submit" class="btn btn-premium-primary w-100">
                                            <i class="fa-solid fa-check me-1"></i> Accept Dispatch Request
                                        </button>
                                    </form>
                                }
                                else if (Model.ActiveAssignment.Status == "Accepted")
                                {
                                    <form asp-controller="RescueTeam" asp-action="StartSimulation" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="teamId" value="@Model.Team.Id" />
                                        <button type="submit" class="btn btn-premium-danger w-100">
                                            <i class="fa-solid fa-route me-1"></i> Depart (Simulate En Route)
                                        </button>
                                    </form>
                                }
                                else if (Model.ActiveAssignment.Status == "OnTheWay" && req.Status != "Rescue In Progress")
                                {
                                    <div class="alert alert-info bg-info bg-opacity-10 border-info border-opacity-25 text-dark fs-8 mb-0">
                                        <i class="fa-solid fa-spinner fa-spin me-1"></i> En route to location. GPS route is simulating... (Arrives automatically in 15 seconds)
                                    </div>
                                }
                                else if (Model.ActiveAssignment.Status == "InProgress" || req.Status == "Rescue In Progress")
                                {
                                    <form asp-controller="RescueTeam" asp-action="UpdateStatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@req.Id" />
                                        <input type="hidden" name="status" value="Resolved" />
                                        <input type="hidden" name="notes" value="Emergency successfully resolved. All citizens accounted for." />
                                        <button type="submit" class="btn btn-premium-success w-100">
                                             <i class="fa-solid fa-circle-check me-1"></i> Mark Incident as Resolved
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted border border-dashed border-secondary rounded">
                        <i class="fa-solid fa-clock fa-2x mb-2 text-muted"></i>
                        <p class="mb-0 fs-8">Standby Mode. Waiting for Command Center dispatch assign.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Navigation Map or Alert list -->
    <div class="col-lg-6 mb-4">
        @if (Model.ActiveAssignment != null && Model.ActiveAssignment.EmergencyRequest != null)
        {
            var req = Model.ActiveAssignment.EmergencyRequest;
            <div class="glass-card card-body-clean mb-4 shadow-sm" style="overflow: hidden;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 text-dark font-weight-bold mb-0"><i class="fa-solid fa-location-arrow text-primary me-2"></i> Rescue Navigation Map</h3>
                    <span class="badge bg-light text-secondary border border-secondary fs-9"><i class="fa-solid fa-satellite me-1 text-success"></i> Live GPS Tracking</span>
                </div>
                <div id="navMap" class="map-container w-100" style="height: 480px; min-height: 420px; max-height: 520px; border-radius: 12px; overflow: hidden;"></div>
            </div>
        }
        else
        {
            <!-- Display Unassigned cases -->
            <div class="glass-card mb-4">
                <div class="card-header-clean bg-light border-bottom">
                    <h3 class="h5 mb-0 text-dark font-weight-bold"><i class="fa-solid fa-clipboard-list text-warning me-2"></i> Global Crisis Queue</h3>
                </div>
                <div class="card-body-clean" id="unassignedQueueContainer">
                    @if (Model.UnassignedEmergencies.Any())
                    {
                        <div class="table-responsive">
                            <table class="table custom-table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Priority</th>
                                        <th>Reported</th>
                                        <th>Distance</th>
                                    </tr>
                                </thead>
                                <tbody id="unassignedQueueBody">
                                    @foreach (var u in Model.UnassignedEmergencies)
                                    {
                                        var dist = Model.Team.CurrentLatitude.HasValue && Model.Team.CurrentLongitude.HasValue ?
                                                   (double?)new TeamAssignmentService(null!).CalculateDistance(u.Latitude, u.Longitude, Model.Team.CurrentLatitude.Value, Model.Team.CurrentLongitude.Value) :
                                                   null;
                                        <tr id="emergency-row-@u.Id">
                                            <td class="text-dark font-weight-bold">@u.EmergencyType</td>
                                            <td>
                                                <span class="badge-priority badge-@u.PriorityLevel.ToLowerInvariant()">@u.PriorityLevel</span>
                                            </td>
                                            <td class="text-secondary fs-9">@u.CreatedAt.ToLocalTime().ToString("t")</td>
                                            <td class="text-info fs-8">@(dist.HasValue ? $"{dist.Value:F1} km" : "N/A")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-circle-check text-success fa-2x mb-2"></i>
                            <p class="mb-0 fs-8">No active emergencies found in the queue.</p>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var myTeamId = @Model.Team.Id;

            // Always listen for TeamAssigned so:
            // 1. If assigned to this team: show SweetAlert2 and reload to show task and map
            // 2. If assigned to another team: remove it from crisis queue so other teams don't see it
            if (window.rescueHub) {
                window.rescueHub.on("TeamAssigned", function(assignedTeamId, rId, tName) {
                    console.log("TeamAssigned event received:", assignedTeamId, rId, tName);
                    if (assignedTeamId === myTeamId) {
                        Swal.fire({
                            icon: 'warning',
                            title: '🚨 Emergency Dispatch Alert!',
                            text: 'Incident #' + rId + ' has been assigned to your rescue squad (' + tName + ') by Command Center.',
                            confirmButtonText: 'Open Emergency Task',
                            confirmButtonColor: '#dc2626'
                        }).then(function() {
                            window.location.reload();
                        });
                    } else {
                        // Remove from queue so it is not visible to this team
                        $('#emergency-row-' + rId).fadeOut(400, function() {
                            $(this).remove();
                            if ($('#unassignedQueueBody tr').length === 0) {
                                $('#unassignedQueueContainer').html('<div class="text-center py-5 text-muted"><i class="fa-solid fa-circle-check text-success fa-2x mb-2"></i><p class="mb-0 fs-8">No active emergencies found in the queue.</p></div>');
                            }
                        });
                    }
                });
            }

            @if (Model.ActiveAssignment != null && Model.ActiveAssignment.EmergencyRequest != null)
            {
                var req = Model.ActiveAssignment.EmergencyRequest;
                var startLat = Model.Team.CurrentLatitude ?? 23.0225m;
                var startLng = Model.Team.CurrentLongitude ?? 72.5714m;
                <text>
                var reqId = @req.Id;
                var destLat = parseFloat("@req.Latitude");
                var destLng = parseFloat("@req.Longitude");

                var curLat = parseFloat("@startLat");
                var curLng = parseFloat("@startLng");

                // Initialize Navigation Map
                var map = L.map('navMap', {
                    center: [curLat, curLng],
                    zoom: 14,
                    minZoom: 3,
                    maxZoom: 19,
                    scrollWheelZoom: true,
                    dragging: true
                });

                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                    maxZoom: 19
                }).addTo(map);

                // Emergency Target Marker (Red)
                var destIcon = L.divIcon({
                    html: '<div style="background: var(--accent-red); border: 2px solid #ffffff; width: 14px; height: 14px; border-radius: 50%; box-shadow: 0 0 10px rgba(239,68,68,0.8);"></div>',
                    className: 'dest-dot',
                    iconSize: [14, 14],
                    iconAnchor: [7, 7]
                });
                var destMarker = L.marker([destLat, destLng], { icon: destIcon }).addTo(map)
                    .bindPopup("Emergency Ground Location").openPopup();

                // Rescue Team Marker (Blue)
                var teamIcon = L.divIcon({
                    html: '<div style="background: var(--accent-blue); border: 2px solid #ffffff; width: 18px; height: 18px; border-radius: 50%; box-shadow: 0 0 12px rgba(59,130,246,0.8); display:flex; align-items:center; justify-content:center;"><i class="fa-solid fa-truck-medical" style="color:white; font-size:10px;"></i></div>',
                    className: 'team-dot',
                    iconSize: [18, 18],
                    iconAnchor: [9, 9]
                });
                var teamMarker = L.marker([curLat, curLng], { icon: teamIcon }).addTo(map)
                    .bindPopup("Your Location");

                // Route path line
                var routeLine = L.polyline([[curLat, curLng], [destLat, destLng]], {
                    color: 'var(--accent-blue)',
                    weight: 3,
                    dashArray: '5, 8',
                    opacity: 0.7
                }).addTo(map);

                // Fit map boundary
                var bounds = new L.featureGroup([destMarker, teamMarker]);
                map.fitBounds(bounds.getBounds().pad(0.2));
                setTimeout(function() { if (map) map.invalidateSize(); }, 200);

                // SignalR update bindings
                if (window.rescueHub) {
                    window.rescueHub.on("TeamLocationUpdate", function(tId, rId, lat, lng, status) {
                        if (tId === myTeamId && rId === reqId) {
                            teamMarker.setLatLng([lat, lng]);
                            routeLine.setLatLngs([[lat, lng], [destLat, destLng]]);
                        }
                    });

                    window.rescueHub.on("StatusUpdate", function(id, status, notes) {
                        if (id === reqId) {
                            $('#operationStatus').text(status);
                            if (status === "Rescue In Progress" || status === "Resolved") {
                                setTimeout(function() { window.location.reload(); }, 1500);
                            }
                        }
                    });
                }
                </text>
            }
        });
    </script>
}
