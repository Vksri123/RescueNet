<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RescueNet</title>
    
    <!-- Modern Typography & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Leaflet.js Mapping CSS (Loaded globally for mapping features) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ResuceNet.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light-glass fixed-top border-bottom border-light">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/rescuenet_logo_shield.jpg" alt="RescueNet Shield Logo" class="brand-logo-img me-2" />
                    <span class="brand-text text-dark font-weight-bold">Rescue<span class="text-danger">Net</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="fa-solid fa-chalkboard-user me-1"></i> Control Center
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "RescueTeams" ? "active" : "")" asp-controller="Admin" asp-action="RescueTeams">
                                        <i class="fa-solid fa-people-group me-1"></i> Manage Rescue Teams
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "CompletedRequests" ? "active" : "")" asp-controller="Admin" asp-action="CompletedRequests">
                                        <i class="fa-solid fa-box-archive me-1"></i> Completed Requests
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole("RescueTeam"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RescueTeam" ? "active" : "")" asp-controller="RescueTeam" asp-action="Dashboard">
                                        <i class="fa-solid fa-house-medical me-1"></i> Team Dashboard
                                    </a>
                                </li>
                            }
                            else // Citizen
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Citizen" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Citizen" asp-action="Dashboard">
                                        <i class="fa-solid fa-gauge-high me-1"></i> Citizen Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Emergency" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")" asp-controller="Emergency" asp-action="Create">
                                        <i class="fa-solid fa-kit-medical text-danger me-1"></i> File Emergency
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
                            <!-- Emergency SMS Notification Bell Dropdown (Only shown when user is logged in) -->
                            <li class="nav-item dropdown me-2" id="smsNotificationContainer" data-user-id="@currentUserId">
                                <a class="nav-link position-relative text-dark d-flex align-items-center justify-content-center p-2 rounded-circle" href="#" id="smsNotificationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Emergency SMS Notifications">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger" id="smsNotificationBadge" style="display: none; font-size: 0.65rem;">
                                        0
                                    </span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 p-0 mt-2" aria-labelledby="smsNotificationDropdown" style="width: 360px; max-width: 90vw; z-index: 1080;">
                                    <div class="px-3 py-2.5 bg-light border-bottom d-flex justify-content-between align-items-center rounded-top-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-bell-fill text-danger fs-6"></i>
                                            <span class="fw-bold text-dark fs-8">Emergency SMS Alerts</span>
                                        </div>
                                        <span class="badge bg-danger rounded-pill fs-9" id="smsNotificationHeaderBadge">0 Alerts</span>
                                    </div>
                                    <div class="p-0" style="max-height: 350px; overflow-y: auto;" id="smsNotificationItemsList">
                                        <div class="p-4 text-center text-muted" id="smsNotificationEmptyState">
                                            <i class="bi bi-bell-slash fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                            <div class="fs-8 fw-medium">No SMS broadcast alerts yet</div>
                                            <div class="fs-9 text-muted">Emergency alerts will appear here.</div>
                                        </div>
                                    </div>
                                    <div class="px-3 py-2 bg-light border-top text-center rounded-bottom-3">
                                        <small class="text-muted fs-9 d-flex align-items-center justify-content-center gap-1">
                                            <i class="fa-solid fa-satellite-dish text-danger"></i> Live Emergency Broadcasts
                                        </small>
                                    </div>
                                </div>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="user-avatar me-2">
                                        <i class="fa-solid fa-circle-user fa-lg"></i>
                                    </div>
                                    <span>@User.FindFirst("FullName")?.Value</span>
                                    <span class="badge bg-secondary ms-2 text-uppercase fs-9">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end fade-in" aria-labelledby="navbarDropdown">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                                            <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-primary nav-btn btn-sm px-3 font-weight-bold" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-danger nav-btn btn-sm px-3 text-white font-weight-bold" asp-controller="Account" asp-action="Register">
                                    <i class="fa-solid fa-user-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="main-content-wrapper flex-grow-1">
        <main role="main" class="container pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-white text-muted border-top" style="position: relative; z-index: 1050;">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-secondary fs-8">&copy; 2026 - <strong>RescueNet</strong> &bull; Smart Disaster Response System &bull; Dedicated to saving lives in any disaster.</span>
            <div>
                <button type="button" class="btn btn-danger btn-sm px-3 py-1 fw-bold shadow-xs rounded-pill d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#presentationModal">
                    <i class="fa-solid fa-photo-film text-warning"></i>
                    <span>Project Presentation Showcase</span>
                    <span class="badge bg-white text-danger rounded-pill px-2 py-0 fs-9 fw-bold">2 Slides</span>
                </button>
            </div>
        </div>
    </footer>

    <!-- Core JS dependencies -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Leaflet Mapping Library JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        if (typeof L !== 'undefined') {
            delete L.Icon.Default.prototype._getIconUrl;
            L.Icon.Default.mergeOptions({
                iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
                iconUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
                shadowUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
            });
        }
    </script>
    
    <!-- SignalR JS Client Library (CDN) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    
    <!-- Global Emergency Broadcast Alert Modal -->
    <div class="modal fade" id="globalSMSAlertModal" tabindex="-1" aria-hidden="true" style="backdrop-filter: blur(10px); z-index: 1060;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border border-danger shadow-lg" style="background: rgba(239, 68, 68, 0.95); color: #ffffff;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title font-weight-bold text-white"><i class="fa-solid fa-triangle-exclamation fa-lg me-2 pulse-slow"></i> EMERGENCY BROADCAST ALERT</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="fs-6 mb-3 text-white" id="globalSMSAlertMessage" style="font-weight: 500;"></p>
                    <div class="d-flex justify-content-between align-items-center fs-8 text-white-50 border-top border-white border-opacity-25 pt-2">
                        <span><i class="fa-solid fa-mobile-screen me-1"></i> Broadcast SMS Alert</span>
                        <span id="globalSMSAlertTime" class="font-monospace"></span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light btn-sm text-danger font-weight-bold px-4" data-bs-dismiss="modal">Acknowledge Alert</button>
                </div>
            </div>
        </div>
    </div>

    <!-- SweetAlert2 Library (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function() {
            @if (TempData["Success"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: '@Html.Raw(TempData["Success"]?.ToString())',
                    confirmButtonColor: '#16a34a',
                    timer: 3500,
                    timerProgressBar: true
                });
                </text>
            }
            @if (TempData["Error"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Notice',
                    text: '@Html.Raw(TempData["Error"]?.ToString())',
                    confirmButtonColor: '#dc2626'
                });
                </text>
            }

            // Load initial SMS Alert Notifications in Navigation Bell (only for logged-in users)
            if ($('#smsNotificationContainer').length > 0) {
                loadSMSAlertNotifications();

                // When user opens/clicks the notification dropdown, mark as seen and immediately hide the count badge
                $(document).on('show.bs.dropdown', '#smsNotificationContainer', function () {
                    markSMSAlertsAsSeen();
                });
                $('#smsNotificationDropdown').on('click', function () {
                    markSMSAlertsAsSeen();
                });
            }

            if (window.rescueHub) {
                window.rescueHub.on("SMSAlertReceived", function(msg, role, timeStr) {
                    $('#globalSMSAlertMessage').text(msg);
                    $('#globalSMSAlertTime').text(timeStr || new Date().toLocaleTimeString());
                    var modal = new bootstrap.Modal(document.getElementById('globalSMSAlertModal'));
                    modal.show();

                    // Instantly refresh navigation bell count and SMS items list if logged in
                    if ($('#smsNotificationContainer').length > 0) {
                        loadSMSAlertNotifications();
                    }
                });
            }
        });

        var latestSMSAlertId = 0;

        function getCurrentUserStorageKey() {
            var userId = $('#smsNotificationContainer').data('user-id') || '0';
            return 'rescuenet_sms_last_seen_user_' + userId;
        }

        function markSMSAlertsAsSeen() {
            if (latestSMSAlertId > 0) {
                var storageKey = getCurrentUserStorageKey();
                localStorage.setItem(storageKey, latestSMSAlertId.toString());

                // Persist seen state in DB per user via API
                $.ajax({
                    url: '/Home/MarkSMSAlertsAsSeen',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ lastSeenId: latestSMSAlertId })
                });
            }
            $('#smsNotificationBadge').hide().text('0');
            $('#smsNotificationItemsList .unread-indicator-dot').remove();
        }

        // Load & Render SMS Notifications for Top Navigation Bar Bell Icon
        function loadSMSAlertNotifications() {
            if ($('#smsNotificationContainer').length === 0) return;

            $.ajax({
                url: '/Home/GetRecentSMSAlerts',
                type: 'GET',
                dataType: 'json',
                success: function (res) {
                    if (res && res.success && Array.isArray(res.alerts)) {
                        renderSMSAlertsList(res.alerts, res.userLastSeenId || 0);
                    }
                },
                error: function (err) {
                    console.warn('Could not load SMS notifications:', err);
                }
            });
        }

        function renderSMSAlertsList(alerts, serverUserLastSeenId) {
            var $badge = $('#smsNotificationBadge');
            var $headerBadge = $('#smsNotificationHeaderBadge');
            var $list = $('#smsNotificationItemsList');

            if (!alerts || alerts.length === 0) {
                $badge.hide().text('0');
                $headerBadge.text('0 Alerts');
                $list.html(`
                    <div class="p-4 text-center text-muted" id="smsNotificationEmptyState">
                        <i class="bi bi-bell-slash fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        <div class="fs-8 fw-medium">No SMS broadcast alerts yet</div>
                        <div class="fs-9 text-muted">Emergency alerts will appear here.</div>
                    </div>
                `);
                return;
            }

            // Track highest alert ID
            latestSMSAlertId = Math.max.apply(Math, alerts.map(function (a) { return a.id || 0; }));

            // Read last seen ID specifically for THIS logged-in user
            var storageKey = getCurrentUserStorageKey();
            var localLastSeenId = parseInt(localStorage.getItem(storageKey) || '0', 10);
            var effectiveLastSeenId = Math.max(localLastSeenId, serverUserLastSeenId || 0);

            // Sync user local storage if server value is newer
            if (effectiveLastSeenId > localLastSeenId) {
                localStorage.setItem(storageKey, effectiveLastSeenId.toString());
            }

            // Count unseen alerts specifically for THIS user
            var unseenAlerts = alerts.filter(function (a) { return (a.id || 0) > effectiveLastSeenId; });
            var unseenCount = unseenAlerts.length;

            if (unseenCount > 0) {
                $badge.text(unseenCount > 99 ? '99+' : unseenCount).show();
            } else {
                $badge.hide().text('0');
            }

            $headerBadge.text(alerts.length + ' Alert' + (alerts.length > 1 ? 's' : ''));

            var itemsHtml = '';
            alerts.forEach(function (alert) {
                var isUnseen = (alert.id || 0) > effectiveLastSeenId;
                var safeMsg = $('<div>').text(alert.message || '').html();
                var safeRole = $('<div>').text(alert.targetRole || 'All').html();
                var timeDisplay = alert.sentAt || alert.timeAgo || 'Recent';
                var recipientBadge = alert.recipients ? `<span class="ms-2"><i class="bi bi-phone me-1"></i>${alert.recipients} sent</span>` : '';
                var unreadDot = isUnseen ? `<span class="badge bg-danger p-1 rounded-circle me-1 unread-indicator-dot" title="New Alert" style="width: 8px; height: 8px; display: inline-block;"></span>` : '';

                itemsHtml += `
                    <div class="px-3 py-2.5 border-bottom bg-white" style="transition: background 0.15s ease;" onmouseover="this.style.backgroundColor='#f8fafc'" onmouseout="this.style.backgroundColor='#ffffff'">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center">
                                ${unreadDot}
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 fs-9 fw-semibold">
                                    <i class="bi bi-broadcast me-1"></i> ${safeRole}
                                </span>
                            </div>
                            <span class="text-muted fs-9">${timeDisplay}</span>
                        </div>
                        <div class="text-dark fs-8 fw-medium text-break" style="line-height: 1.35;">${safeMsg}</div>
                        <div class="text-muted fs-9 mt-1 d-flex align-items-center">
                            <span class="text-danger fw-semibold"><i class="fa-solid fa-circle-exclamation me-1"></i> Broadcast Alert</span>
                            ${recipientBadge}
                        </div>
                    </div>
                `;
            });

            $list.html(itemsHtml);
        }

        // Global SweetAlert2 delete confirmation helper
        function confirmDeleteWithSwal(event, itemName) {
            event.preventDefault();
            var form = event.target.closest('form');
            Swal.fire({
                title: 'Are you sure?',
                text: itemName ? 'Permanently delete \'' + itemName + '\'? This action cannot be undone.' : 'This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then(function(result) {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
            return false;
        }
    </script>

    <!-- Global Full-Screen Presentation Showcase Modal (Swapped Slide Order: Slide 1 = Mission & Thanks; Slide 2 = Team Showcase) -->
    <div class="modal fade" id="presentationModal" tabindex="-1" aria-labelledby="presentationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content border-0 bg-black text-white">
                <!-- Modal Header -->
                <div class="modal-header bg-dark text-white px-4 py-2 d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-25">
                    <div class="d-flex align-items-center gap-3">
                        <img src="~/images/rescuenet_logo_shield.jpg" alt="RescueNet Shield Logo" class="brand-logo-img" style="width: 34px; height: 34px;" />
                        <div>
                            <h5 class="modal-title fw-bold mb-0 text-white fs-6" id="presentationModalLabel">RescueNet &bull; Smart Disaster Response Presentation</h5>
                            <small class="text-white-50 fs-9" id="slideIndicatorText">Slide 1 of 2: Because Every Life Matters &bull; Mission Showcase</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="btnFullscreenToggle" title="Toggle Browser Fullscreen">
                            <i class="fa-solid fa-expand me-1"></i> Fullscreen
                        </button>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                </div>

                <!-- Modal Body with Full-Screen Carousel -->
                <div class="modal-body p-0 bg-black position-relative d-flex align-items-center justify-content-center overflow-hidden">
                    <div id="presentationCarousel" class="carousel slide w-100 h-100" data-bs-ride="false" data-bs-interval="false">
                        <div class="carousel-inner w-100 h-100">
                            <!-- Slide 1 (Swapped to First): Mission & Thanks Showcase (16:9 Widescreen) -->
                            <div class="carousel-item active w-100 h-100 text-center">
                                <div class="presentation-slide-wrapper">
                                    <img src="~/images/presentation_mission_widescreen.jpg" class="presentation-img img-fluid" alt="RescueNet Because Every Life Matters Showcase 16:9" />
                                </div>
                            </div>
                            <!-- Slide 2 (Swapped to Second): Team Showcase (16:9 Widescreen) -->
                            <div class="carousel-item w-100 h-100 text-center">
                                <div class="presentation-slide-wrapper">
                                    <img src="~/images/presentation_team_widescreen.jpg" class="presentation-img img-fluid" alt="RescueNet Team Dedication Showcase 16:9" />
                                </div>
                            </div>
                        </div>

                        <!-- Slide Floating Nav Arrows -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#presentationCarousel" data-bs-slide="prev" style="width: 5%;">
                            <span class="carousel-control-prev-icon bg-dark bg-opacity-75 rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#presentationCarousel" data-bs-slide="next" style="width: 5%;">
                            <span class="carousel-control-next-icon bg-dark bg-opacity-75 rounded-circle p-3" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>

                <!-- Modal Footer Controls -->
                <div class="modal-footer bg-dark border-top border-secondary border-opacity-25 px-4 py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-light btn-sm px-3 py-1 fw-semibold" id="btnPrevSlideBottom">
                        <i class="fa-solid fa-chevron-left me-1"></i> Previous Slide
                    </button>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold" id="btnGoSlide1">
                            <i class="fa-solid fa-heart-pulse me-1"></i> Slide 1: Every Life Matters
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-bold" id="btnGoSlide2">
                            <i class="fa-solid fa-users me-1"></i> Slide 2: Team Showcase
                        </button>
                    </div>

                    <button type="button" class="btn btn-danger btn-sm px-3 py-1 fw-semibold" id="btnNextSlideBottom">
                        Next Slide <i class="fa-solid fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            var carouselEl = document.getElementById('presentationCarousel');
            if (carouselEl && typeof bootstrap !== 'undefined') {
                var carousel = new bootstrap.Carousel(carouselEl, {
                    interval: false,
                    wrap: true
                });

                function updateSlideInfo(slideIndex) {
                    if (slideIndex === 0) {
                        $('#slideIndicatorText').html('Slide 1 of 2: Because Every Life Matters &bull; Mission Showcase');
                        $('#btnGoSlide1').removeClass('btn-outline-light').addClass('btn-primary');
                        $('#btnGoSlide2').removeClass('btn-primary').addClass('btn-outline-light');
                    } else {
                        $('#slideIndicatorText').text('Slide 2 of 2: Team Dedication & Collaboration');
                        $('#btnGoSlide2').removeClass('btn-outline-light').addClass('btn-primary');
                        $('#btnGoSlide1').removeClass('btn-primary').addClass('btn-outline-light');
                    }
                }

                carouselEl.addEventListener('slide.bs.carousel', function (e) {
                    updateSlideInfo(e.to);
                });

                $('#btnPrevSlideBottom').on('click', function () {
                    carousel.prev();
                });

                $('#btnNextSlideBottom').on('click', function () {
                    carousel.next();
                });

                $('#btnGoSlide1').on('click', function () {
                    carousel.to(0);
                });

                $('#btnGoSlide2').on('click', function () {
                    carousel.to(1);
                });

                // Keyboard arrow navigation when presentation modal is open
                $(document).on('keydown', function (e) {
                    if ($('#presentationModal').hasClass('show')) {
                        if (e.key === 'ArrowLeft') {
                            carousel.prev();
                        } else if (e.key === 'ArrowRight') {
                            carousel.next();
                        }
                    }
                });

                // Fullscreen toggle
                $('#btnFullscreenToggle').on('click', function () {
                    var modalEl = document.getElementById('presentationModal');
                    if (!document.fullscreenElement) {
                        if (modalEl.requestFullscreen) {
                            modalEl.requestFullscreen();
                        } else if (modalEl.webkitRequestFullscreen) {
                            modalEl.webkitRequestFullscreen();
                        }
                        $(this).html('<i class="fa-solid fa-compress me-1"></i> Exit');
                    } else {
                        if (document.exitFullscreen) {
                            document.exitFullscreen();
                        }
                        $(this).html('<i class="fa-solid fa-expand me-1"></i> Fullscreen');
                    }
                });

                document.addEventListener('fullscreenchange', function () {
                    if (!document.fullscreenElement) {
                        $('#btnFullscreenToggle').html('<i class="fa-solid fa-expand me-1"></i> Fullscreen');
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
