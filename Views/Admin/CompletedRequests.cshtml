@model List<EmergencyRequest>
@{
    ViewData["Title"] = "Resolved Incident Archive";
    var assignments = ViewBag.Assignments as List<EmergencyAssignment> ?? new List<EmergencyAssignment>();
    var histories = ViewBag.Histories as List<EmergencyStatusHistory> ?? new List<EmergencyStatusHistory>();
}

<div class="page-header-card fade-in">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="h3 text-dark fw-bold mb-1">
                <i class="fa-solid fa-box-archive text-success me-2"></i> Completed Crisis Archive
            </h2>
            <p class="text-secondary fs-8 mb-0">Historical log of all resolved and closed emergency incidents</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-dark btn-sm fw-semibold">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Control Center
            </a>
        </div>
    </div>
</div>

<div class="row fade-in mb-4">

    <!-- Summary Metrics -->
    <div class="col-md-4 mb-3">
        <div class="metric-box metric-box-low bg-white shadow-sm border">
            <div>
                <span class="text-success d-block fs-8 text-uppercase fw-semibold">Total Resolved Cases</span>
                <span class="metric-number text-success">@Model.Count</span>
            </div>
            <div class="metric-icon text-success opacity-75"><i class="fa-solid fa-circle-check"></i></div>
        </div>
    </div>
    <div class="col-md-8 mb-3">
        <div class="glass-card h-100 p-3 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-3 w-100">
                <i class="fa-solid fa-magnifying-glass text-muted ms-2"></i>
                <input type="text" id="archiveSearch" class="form-control form-control-dark border-0" placeholder="Search by citizen, crisis type, or keyword..." />
            </div>
        </div>
    </div>
</div>

<div class="row fade-in">
    <div class="col-12">
        <div class="glass-card">
            <div class="card-header-clean bg-light border-bottom">
                <h3 class="h5 mb-0 text-dark fw-bold"><i class="fa-solid fa-list text-primary me-2"></i> Resolved Cases Log</h3>
            </div>
            <div class="card-body-clean">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table custom-table" id="archiveTable">
                            <thead>
                                <tr>
                                    <th>Incident ID</th>
                                    <th>Category</th>
                                    <th>Citizen Info</th>
                                    <th>Description</th>
                                    <th>Priority / Risk</th>
                                    <th>Assigned Crew</th>
                                    <th>Resolved Time</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    var assignment = assignments.FirstOrDefault(a => a.EmergencyRequestId == r.Id);
                                    var resHistory = histories.Where(h => h.EmergencyRequestId == r.Id && (h.Status == "Resolved" || h.Status == "Completed")).OrderByDescending(h => h.ChangedAt).FirstOrDefault();
                                    
                                    <tr>
                                        <td class="font-monospace text-secondary fw-semibold">#@r.Id</td>
                                        <td>
                                            <span class="badge bg-secondary">@r.EmergencyType</span>
                                        </td>
                                        <td>
                                            <span class="text-dark font-weight-bold d-block">@r.Citizen?.FullName</span>
                                            <span class="text-secondary fs-9"><i class="fa-solid fa-phone me-1"></i> @(r.Citizen?.PhoneNumber ?? "N/A")</span>
                                        </td>
                                        <td class="text-dark fs-8" style="max-width: 250px;">
                                            "@r.Description"
                                        </td>
                                        <td>
                                            <span class="badge-priority badge-@r.PriorityLevel.ToLowerInvariant() d-inline-block mb-1">@r.PriorityLevel</span>
                                            <span class="d-block fs-9 text-muted">Risk: @r.RiskScore/100</span>
                                        </td>
                                        <td>
                                            @if (assignment != null && assignment.RescueTeam != null)
                                            {
                                                <span class="text-dark font-weight-bold d-block">@assignment.RescueTeam.TeamName</span>
                                                <span class="text-info fs-9 fw-semibold">Hotline: @assignment.RescueTeam.ContactNumber</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-8">System Resolved</span>
                                            }
                                        </td>
                                        <td class="text-secondary fs-9 font-monospace">
                                            @(resHistory != null ? resHistory.ChangedAt.ToLocalTime().ToString("g") : r.UpdatedAt.ToLocalTime().ToString("g"))
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="Emergency" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary fw-semibold">
                                                <i class="fa-solid fa-folder-open me-1"></i> Details
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination Footer -->
                    <div class="card-footer-clean bg-light border-top px-4 py-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2" id="archivePaginationFooter">
                        <div class="text-secondary fs-8" id="paginationInfo">
                            Showing <span class="text-dark fw-bold" id="pageStart">1</span> to <span class="text-dark fw-bold" id="pageEnd">10</span> of <span class="text-dark fw-bold" id="totalRecords">@Model.Count</span> resolved cases
                        </div>
                        <nav aria-label="Archive table pagination">
                            <ul class="pagination pagination-sm mb-0 gap-1" id="paginationControls">
                                <!-- Dynamic page buttons injected via JS -->
                            </ul>
                        </nav>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-box-open fa-3x mb-3 text-muted opacity-50"></i>
                        <h4 class="h5 text-dark fw-bold">No Resolved Incidents Found</h4>
                        <p class="fs-8 mb-0">Incidents will appear in this archive once marked as Resolved by rescue crews or admins.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const pageSize = 10;
            let currentPage = 1;
            const $allRows = $('#archiveTable tbody tr');
            let $matchingRows = $allRows;

            function updatePagination() {
                const totalMatching = $matchingRows.length;
                const totalPages = Math.ceil(totalMatching / pageSize) || 1;

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }
                if (currentPage < 1) {
                    currentPage = 1;
                }

                // Hide all rows first
                $allRows.hide();

                if (totalMatching === 0) {
                    $('#archivePaginationFooter').hide();
                    $('#noResultsRow').remove();
                    $('#archiveTable tbody').append('<tr id="noResultsRow"><td colspan="8" class="text-center py-4 text-muted"><i class="fa-solid fa-magnifying-glass me-2"></i>No matching resolved cases found.</td></tr>');
                    return;
                } else {
                    $('#noResultsRow').remove();
                }

                // Calculate slice for 10 cases per page
                const startIndex = (currentPage - 1) * pageSize;
                const endIndex = Math.min(startIndex + pageSize, totalMatching);

                // Show only the current page rows
                $matchingRows.slice(startIndex, endIndex).show();

                // Update Info Text
                $('#pageStart').text(startIndex + 1);
                $('#pageEnd').text(endIndex);
                $('#totalRecords').text(totalMatching);
                $('#archivePaginationFooter').show();

                // Render Pagination Controls
                renderPaginationButtons(totalPages);
            }

            function renderPaginationButtons(totalPages) {
                const $pagination = $('#paginationControls');
                $pagination.empty();

                if (totalPages <= 1) {
                    $pagination.hide();
                    return;
                }
                $pagination.show();

                // Previous Button
                const prevDisabled = currentPage === 1 ? 'disabled' : '';
                $pagination.append(`
                    <li class="page-item ${prevDisabled}">
                        <button type="button" class="page-link rounded-2 px-2.5 py-1 text-dark fw-semibold" id="btnPrevPage" title="Previous Page" ${currentPage === 1 ? 'disabled' : ''}>
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                    </li>
                `);

                // Page Number Buttons
                for (let i = 1; i <= totalPages; i++) {
                    const isActive = i === currentPage ? 'active' : '';
                    $pagination.append(`
                        <li class="page-item ${isActive}">
                            <button type="button" class="page-link rounded-2 px-3 py-1 fw-bold ${i === currentPage ? 'bg-primary text-white border-primary' : 'text-dark'}" data-page="${i}">
                                ${i}
                            </button>
                        </li>
                    `);
                }

                // Next Button
                const nextDisabled = currentPage === totalPages ? 'disabled' : '';
                $pagination.append(`
                    <li class="page-item ${nextDisabled}">
                        <button type="button" class="page-link rounded-2 px-2.5 py-1 text-dark fw-semibold" id="btnNextPage" title="Next Page" ${currentPage === totalPages ? 'disabled' : ''}>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </li>
                `);
            }

            // Click Handlers for Page Buttons
            $(document).on('click', '#paginationControls button[data-page]', function () {
                currentPage = parseInt($(this).data('page'));
                updatePagination();
            });

            $(document).on('click', '#btnPrevPage', function () {
                if (currentPage > 1) {
                    currentPage--;
                    updatePagination();
                }
            });

            $(document).on('click', '#btnNextPage', function () {
                const totalPages = Math.ceil($matchingRows.length / pageSize) || 1;
                if (currentPage < totalPages) {
                    currentPage++;
                    updatePagination();
                }
            });

            // Search input live filtering + pagination recalculation
            $('#archiveSearch').on('input', function () {
                const query = $(this).val().toLowerCase().trim();
                if (!query) {
                    $matchingRows = $allRows;
                } else {
                    $matchingRows = $allRows.filter(function () {
                        return $(this).text().toLowerCase().indexOf(query) > -1;
                    });
                }
                currentPage = 1;
                updatePagination();
            });

            // Initial load
            updatePagination();
        });
    </script>
}
