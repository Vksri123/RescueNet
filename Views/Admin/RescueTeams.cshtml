@model List<RescueTeam>
@{
    ViewData["Title"] = "Rescue Teams Management";
    int availableCount = Model.Count(t => t.Status == "Available");
    int busyCount = Model.Count(t => t.Status == "Busy");
    int offlineCount = Model.Count(t => t.Status != "Available" && t.Status != "Busy");
}

<div class="fade-in">
    <!-- Header Bar -->
    <div class="page-header-card fade-in">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h2 class="h3 text-dark fw-bold mb-1">
                    <i class="fa-solid fa-people-group text-primary me-2"></i> Rescue Teams Management
                </h2>
                <p class="text-secondary fs-8 mb-0">Manage registered first-responder rescue squads, duty availability, and squad fleet</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-dark btn-sm fw-semibold">
                    <i class="fa-solid fa-chalkboard-user me-1"></i> Control Center
                </a>
                <a asp-controller="Admin" asp-action="CompletedRequests" class="btn btn-outline-success btn-sm fw-semibold">
                    <i class="fa-solid fa-box-archive me-1"></i> Resolved Archive
                </a>
            </div>
        </div>
    </div>

    <!-- Team Metrics Strip -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="metric-box bg-white shadow-sm border p-3 rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-secondary d-block fs-9 text-uppercase fw-semibold">Total Teams</span>
                    <span class="h4 mb-0 text-dark fw-bold">@Model.Count</span>
                </div>
                <div class="metric-icon text-primary opacity-75 fs-3"><i class="fa-solid fa-people-roof"></i></div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="metric-box bg-white shadow-sm border p-3 rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-success d-block fs-9 text-uppercase fw-semibold">Available for Dispatch</span>
                    <span class="h4 mb-0 text-success fw-bold">@availableCount</span>
                </div>
                <div class="metric-icon text-success opacity-75 fs-3"><i class="fa-solid fa-truck-medical"></i></div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="metric-box bg-white shadow-sm border p-3 rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-danger d-block fs-9 text-uppercase fw-semibold">Busy on Operations</span>
                    <span class="h4 mb-0 text-danger fw-bold">@busyCount</span>
                </div>
                <div class="metric-icon text-danger opacity-75 fs-3"><i class="fa-solid fa-truck-fire"></i></div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="metric-box bg-white shadow-sm border p-3 rounded-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted d-block fs-9 text-uppercase fw-semibold">Offline Teams</span>
                    <span class="h4 mb-0 text-secondary fw-bold">@offlineCount</span>
                </div>
                <div class="metric-icon text-secondary opacity-75 fs-3"><i class="fa-solid fa-power-off"></i></div>
            </div>
        </div>
    </div>

    <!-- Teams Table Card -->
    <div class="glass-card mb-4">
        <div class="card-header-clean bg-light d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0 text-dark fw-bold">
                <i class="fa-solid fa-list-check text-primary me-2"></i> Registered Rescue Squads
            </h3>
            <span class="badge bg-secondary">@Model.Count Squad(s) Registered</span>
        </div>
        <div class="card-body-clean">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle">
                        <thead>
                            <tr>
                                <th>Team ID</th>
                                <th>Rescue Squad Name</th>
                                <th>Hotline Contact</th>
                                <th>Officer / Account</th>
                                <th>Duty Status</th>
                                <th>Current Coordinates</th>
                                <th class="text-center" style="width: 140px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td class="font-monospace text-secondary fw-semibold">#@t.Id</td>
                                    <td class="font-weight-bold text-dark">
                                        <i class="fa-solid fa-truck-medical text-primary me-2"></i> @t.TeamName
                                    </td>
                                    <td class="text-dark">@t.ContactNumber</td>
                                    <td class="text-dark fw-medium">@(t.User?.FullName ?? t.User?.Username ?? "N/A")</td>
                                    <td>
                                        @if (t.Status == "Available")
                                        {
                                            <span class="badge bg-success px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Available</span>
                                        }
                                        else if (t.Status == "Busy")
                                        {
                                            <span class="badge bg-danger px-2 py-1"><i class="fa-solid fa-person-running me-1"></i> Busy on Operation</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1"><i class="fa-solid fa-moon me-1"></i> Offline</span>
                                        }
                                    </td>
                                    <td class="font-monospace text-secondary fs-9">
                                        @if (t.CurrentLatitude.HasValue && t.CurrentLongitude.HasValue)
                                        {
                                            <span>@t.CurrentLatitude.Value.ToString("F4"), @t.CurrentLongitude.Value.ToString("F4")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not deployed</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-controller="Admin" asp-action="DeleteRescueTeam" method="post" class="d-inline" onsubmit="return confirmDeleteWithSwal(event, '@t.TeamName');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2 fw-semibold" title="Delete rescue team">
                                                <i class="fa-solid fa-trash-can me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-people-group fa-3x mb-3 text-secondary opacity-50"></i>
                    <h4 class="h6 text-dark fw-bold">No Rescue Teams Registered</h4>
                    <p class="fs-8 text-secondary mb-0">First responder teams can register via the response account registration portal.</p>
                </div>
            }
        </div>
    </div>
</div>
