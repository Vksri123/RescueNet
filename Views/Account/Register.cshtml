@model RegisterViewModel
@{
    ViewData["Title"] = "Establish Grid Account";
}

<div class="row justify-content-center align-items-center py-5 fade-in">
    <div class="col-md-7">
        <div class="glass-card">
            <div class="card-header-clean text-center">
                <i class="fa-solid fa-user-plus text-danger fa-2.5x mb-3 pulse-slow"></i>
                <h2 class="h3 text-white">Create Response Account</h2>
                <p class="text-muted mb-0">Join the RescueNet coordination grid</p>
            </div>
            <div class="card-body-clean">
                <form asp-action="Register" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fs-9"></div>

                    <div class="row">
                        <!-- Account Details -->
                        <div class="col-md-6 mb-4">
                            <label asp-for="Username" class="form-label text-white-50"><i class="fa-solid fa-user me-1"></i> Username</label>
                            <input asp-for="Username" class="form-control form-control-dark" placeholder="Choose a username" />
                            <span asp-validation-for="Username" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="FullName" class="form-label text-white-50"><i class="fa-solid fa-signature me-1"></i> Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-dark" placeholder="John Doe" />
                            <span asp-validation-for="FullName" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="PhoneNumber" class="form-label text-white-50"><i class="fa-solid fa-phone me-1"></i> Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-dark" placeholder="e.g. +1 555-0199" />
                            <span asp-validation-for="PhoneNumber" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Role" class="form-label text-white-50"><i class="fa-solid fa-users-gear me-1"></i> System Role</label>
                            <select asp-for="Role" class="form-select form-control-dark" id="roleSelector" style="background-image: url('data:image/svg+xml,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3e%3cpath fill=%27none%27 stroke=%27%23ffffff%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27 stroke-width=%272%27 d=%27m2 5 6 6 6-6%27/%3e%3c/svg%3e');">
                                <option value="Citizen" selected>Citizen (Report & Track)</option>
                                <option value="RescueTeam">Rescue Crew (First Responder)</option>
                                <option value="Admin">System Administrator</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Dynamic Rescue Team Section -->
                    <div id="rescueTeamSection" class="p-3 mb-4 rounded border border-danger border-opacity-25 bg-danger bg-opacity-5 fade-in d-none">
                        <h4 class="h6 text-danger mb-3"><i class="fa-solid fa-shield-halved me-1"></i> Rescue Team Operations Setup</h4>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TeamName" class="form-label text-white-50">Rescue Team Name</label>
                                <input asp-for="TeamName" class="form-control form-control-dark" placeholder="e.g. Alpha Squad" />
                                <span asp-validation-for="TeamName" class="text-danger fs-9 mt-1 d-block"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TeamContactNumber" class="form-label text-white-50">Team Hotline Number</label>
                                <input asp-for="TeamContactNumber" class="form-control form-control-dark" placeholder="e.g. +1 555-0100" />
                                <span asp-validation-for="TeamContactNumber" class="text-danger fs-9 mt-1 d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Password" class="form-label text-white-50"><i class="fa-solid fa-lock me-1"></i> Security Password</label>
                            <input asp-for="Password" class="form-control form-control-dark" placeholder="At least 6 characters" />
                            <span asp-validation-for="Password" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-white-50"><i class="fa-solid fa-lock-open me-1"></i> Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-dark" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger fs-9 mt-1 d-block"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-premium-danger w-100 py-2.5">
                        <i class="fa-solid fa-user-plus me-1"></i> Complete Register
                    </button>
                </form>
            </div>
            <div class="card-footer border-top border-secondary text-center py-3 bg-dark bg-opacity-25" style="border-radius: 0 0 var(--border-radius-lg) var(--border-radius-lg);">
                <span class="text-muted">Already registered? </span>
                <a asp-action="Login" class="text-danger font-weight-bold text-decoration-none">Verify Account</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            function toggleTeamFields() {
                const role = $('#roleSelector').val();
                if (role === 'RescueTeam') {
                    $('#rescueTeamSection').removeClass('d-none').addClass('fade-in');
                } else {
                    $('#rescueTeamSection').addClass('d-none').removeClass('fade-in');
                }
            }

            // Bind events
            $('#roleSelector').change(toggleTeamFields);
            
            // Execute on load
            toggleTeamFields();
        });
    </script>
}
